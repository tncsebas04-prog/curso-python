def calcular_edad(actual, nacimiento):
    return actual - nacimiento

actual = 2026
nacimiento = int(input("Ingrese su año de nacimiento:"))
while nacimiento <= 0 or nacimiento > actual:
    print("El año de nacimiento debe ser mayor a 0 y menor o igual al año actual. Por favor, ingresa un año válido.")
    nacimiento = int(input("Ingrese su año de nacimiento:"))

edad = calcular_edad(actual, nacimiento)
print(f"Su edad es: {edad}")