agenda = {"juan": "123456789", "maria": "987654321", "pedro": "456789123", "carlos": "111222333"}

def buscar_contacto(nombre):
    if nombre in agenda:
        print(f"El número de {nombre} es: {agenda[nombre]}")
    else:
        print(f"{nombre} no se encuentra en la agenda.")

busqueda = input("Ingrese el nombre del contacto que desea buscar: ")
buscar_contacto(busqueda)

print("agenda completa:")
for nombre, telefono in agenda.items():
    print(f"{nombre}: {telefono}")

print(agenda["ana"])